<?xml version="1.0"?>
<package format="2">
  <name>tron_nav_dashboard</name>
  <version>0.1.0</version>
  <description>Read-only navigation diagnostics and laptop dashboard for GPS-TRON1.</description>

  <maintainer email="user@todo.todo">TRON1 Operator</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>tron_local_collision_safety</depend>
  <depend>tron_open_space_nav</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>rosbag</exec_depend>

  <export/>
</package>
