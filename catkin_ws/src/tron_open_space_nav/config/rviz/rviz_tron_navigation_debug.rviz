Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Alpha: 0.5
      Cell Size: 1
      Plane: XY
      Reference Frame: map
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/PointCloud2
      Enabled: true
      Name: Livox Filtered Cloud
      Topic: /livox/lidar_filter1
      Queue Size: 5
      Selectable: true
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 0
      Alpha: 1
    - Class: rviz/Odometry
      Enabled: true
      Name: High Rate Odometry
      Topic: /Odometry
      Keep: 100
      Position Tolerance: 0.01
      Angle Tolerance: 0.01
      Shape:
        Alpha: 1
        Axes Length: 0.6
        Axes Radius: 0.05
        Color: 255; 25; 0
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.6
        Shaft Radius: 0.05
        Value: Arrow
    - Class: rviz/Path
      Enabled: true
      Name: OpenNav Actual Path
      Topic: /open_nav/path
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
      Color: 255; 255; 0
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.6
      Yaw: 0.8
